version = "1.0"
name = "New Request"
method = "POST"
url = "https://postman-echo.com/post"

[settings]
inherit_auth = true
verify_ssl = true
follow_redirects = true
max_redirects = 5
timeout_ms = 0

[headers]
Accept = "application/json"

[flow]
once_per_run = false
retry_until = ""
retry_interval_ms = 500
max_retries = 3
delay_ms = 0
jitter_min_ms = 0
jitter_max_ms = 0

[body.json]
```json
[
  {
    "id": 1,
    "name": "Jane Doe",
    "email": "jane.doe@example.com",
    "role": "Software Engineer",
    "isActive": true,
    "skills": ["JavaScript", "TypeScript", "React", "Node.js"]
  },
  {
    "id": 2,
    "name": "John Smith",
    "email": "john.smith@example.com",
    "role": "Product Manager",
    "isActive": false,
    "skills": ["Agile", "Scrum", "Roadmapping", "User Research"]
  },
  {
    "id": 3,
    "name": "Alice Johnson",
