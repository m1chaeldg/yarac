{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend: Chrome (Live Reload)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "start-frontend-dev",
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/frontend/src/*",
        "/*": "${workspaceFolder}/frontend/*"
      }
    },
    {
      "name": "Frontend: Edge (Live Reload)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true,
      "preLaunchTask": "start-frontend-dev",
      "smartStep": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**"
      ],
      "sourceMapPathOverrides": {
        "/src/*": "${workspaceFolder}/frontend/src/*",
        "/*": "${workspaceFolder}/frontend/*"
      }
    },
    {
      "name": "Frontend: Attach to Browser (Port 9222)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "url": "http://localhost:5173/*",
      "webRoot": "${workspaceFolder}/frontend",
      "sourceMaps": true
    },
    {
      "name": "UI: Debug yarac-ui (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/yarac-ui.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-yarac-ui"
    },
    {
      "name": "UI: Debug yarac-ui (MSVC C/C++)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/yarac-ui.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-yarac-ui"
    },
    {
      "name": "Backend: Debug yarac-cli Run (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/yarac-cli.exe",
      "args": ["run", "${workspaceFolder}/workspace"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-yarac-cli"
    },
    {
      "name": "Backend: Debug yarac-cli Serve Daemon (CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/yarac-cli.exe",
      "args": ["serve", "--workspace", "${workspaceFolder}/workspace", "--port", "9475"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-yarac-cli"
    },
    {
      "name": "Backend: Debug yarac-cli (MSVC C/C++)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/yarac-cli.exe",
      "args": ["run", "${workspaceFolder}/workspace"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build-yarac-cli"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Chrome + yarac-cli Serve (CodeLLDB)",
      "configurations": [
        "Frontend: Chrome (Live Reload)",
        "Backend: Debug yarac-cli Serve Daemon (CodeLLDB)"
      ]
    }
  ]
}
